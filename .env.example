# Authentication & RBAC (Auth.js v5 — Social Login: Google, Microsoft Entra ID, Facebook)
AUTH_SECRET=replace_with_openssl_rand_base64_32_or_npx_auth_secret
ADMIN_EMAILS=timdbowden@gmail.com,admin@plantandrobinson.com
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
